<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClassInsight.Agent</RootNamespace>
    <AssemblyName>ClassInsight.Agent</AssemblyName>
    <!-- Agent runs headless on lab PCs; no window. WPF is referenced only for its managed
         UI Automation client (System.Windows.Automation), used to read the foreground browser's
         address bar (FR-AGENT-06). -->
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorcery.VP8" Version="10.0.17" />
    <!-- DXGI Desktop Duplication (GPU screen capture) — managed D3D11/DXGI bindings. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassInsight.Shared\ClassInsight.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the (optional) IT settings next to the exe, outside the single-file bundle, so an
         admin can set RoomName / ServerAddress per lab without rebuilding. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClassInsight.Tests" />
  </ItemGroup>

</Project>
